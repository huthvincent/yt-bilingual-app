# DeepSeek API Key (Required for translation, summary, and dictionary)
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
# Optional override (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# OpenSubtitles Credentials (Required ONLY if you use download_subtitles.py)
OPENSUBTITLES_API_KEY="your_opensubtitles_api_key_here"
OPENSUBTITLES_USERNAME="your_username_here"
OPENSUBTITLES_PASSWORD="your_password_here"

# --- Optional: public deployment hardening ---
# Comma-separated allowed CORS origins (default "*" for local use)
# CORS_ORIGINS=https://your-frontend.example.com
# When set, all /api requests must send a matching X-API-Key header
# (frontend: set VITE_API_KEY to the same value at build time)
# API_AUTH_KEY=

# Whisper model size for the optional no-captions ASR fallback (tiny/base/small/medium)
# WHISPER_MODEL=base

# Opt-in public tunnel in start_app.command (REQUIRES API_AUTH_KEY to be set)
# ENABLE_TUNNEL=1
# TUNNEL_SUBDOMAIN=my-app
